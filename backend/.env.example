# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/clinic-care

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# First admin account (created automatically when no admin exists)
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=ChangeMe123!

# Optional admin profile fields for seed script
# ADMIN_FULLNAME=System Admin
# ADMIN_PHONE=9876543210
